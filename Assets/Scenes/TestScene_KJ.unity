  Dialogs:
  - speakerIndex: 0
    name: "\uC8FC\uD76C"
    dialogue: "\uC774\uB807\uAC8C DialougeSystem\uC744 \uC5EC\uB7EC\uAC1C \uB9CC\uB4E4\uC5B4\uC11C
      \uBD84\uAE30\uB97C \uAD6C\uBD84\uD560 \uC218 \uC788\uB2E4."
  - speakerIndex: 1
    name: "\uBBFC\uC8FC"
    dialogue: "\uB300\uC0AC\uB85C \uC774\uB8E8\uC5B4\uC9C4 \uBD84\uAE30 \uC0AC\uC774\uC5D0
      \uCE90\uB9AD\uD130\uB97C \uC6C0\uC9C1\uC774\uAC70\uB098 \uC624\uBE0C\uC81D\uD2B8\uB97C
      \uC0DD\uC131\uD558\uB294 \uAC83\uACFC \uAC19\uC544"
  - speakerIndex: 1
    name: "\uBBFC\uC8FC"
    dialogue: "\uAC8C\uC784 \uC9C4\uD589\uC5D0 \uD544\uC694\uD55C \uC5EC\uB7EC \uD589\uB3D9\uC744\uD558\uACE0,
      \uD544\uC694\uD560 \uB54C \uB610 \uB300\uC0AC\uB85C \uCD9C\uB825\uD558\uB3C4\uB85D
      \uD55C\uB2E4."
  isAutoStart: 1
